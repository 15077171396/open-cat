# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/venv/
env/
venv/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt

# 本地工具会话状态（不入库）
.mimosa/
.trae/
# AI 助手的工作记忆与预览产物（与 .trae / .mimosa 同类：本地工具状态，不入库）。
# ⚠️ 目录本身不要删除（存有项目长期记忆），只是不纳入版本管理。
.workbuddy/
.workbuddy-ai/

# Environment variables
.env
.env.local
.env.*.local

# 服务器上可能残留旧的 Umami Basic Auth 口令文件（含密码哈希，绝不入库）。
# 该控制已随 Umami v3 的 Bearer 认证冲突而撤除，此条只作为误提交的兜底防护。
nginx/.htpasswd

# Node.js
frontend/node_modules/
frontend/dist/
admin-frontend/node_modules/
admin-frontend/dist/
miniprogram/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ⚠️ package-lock.json 必须入库，不要在这里忽略它
# （曾经被忽略，导致 npm ci 永远失败并退回 npm install，依赖版本不可复现；
#   前端两个工程 + miniprogram 的 lockfile 都要提交。
#   scripts/check_ci_config.py 会对本行做回归检查）

# Build outputs
build/
dist-ssr/
*.local
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/*
# 保留目录本身：compose 把 ./logs 挂进容器，缺目录时 Docker 会以 root 建一个，
# 非 root 运行的后端可能写不进去（表现为日志静默丢失）
!logs/.gitkeep

# Database
*.db
*.sqlite3

# Alembic (迁移文件必须入库, 否则部署时 alembic upgrade head 无迁移可执行)
backend/alembic/versions/__pycache__/

# 用户上传文件（运行时生成，不入库）
# ⚠️ 本地 uploads 目录已随 P2-10 移除：上传全部走腾讯云 COS，本地无写入方。

# Vite 配置编译产物（由 vite.config.ts 编译生成）
admin-frontend/vite.config.js
admin-frontend/vite.config.d.ts

# 部署压缩包与运行时临时文件
*.tar.gz
log.txt
backend/pip_version.txt

# 本地会话临时文件（不入库）
.git-commit-msg.txt
msg-check.txt

# 本地隧道配置（含服务器地址等个人环境信息，不入库）
# 见 scripts/tunnel.ps1 的取值说明：写入一行 $Server = "root@<服务器IP>"
scripts/tunnel.local.ps1

# 数据库备份产物（scripts/backup_mysql.sh 生成，含全量业务数据，绝不入库）
backups/

# 前端构建产物（`vite build --outDir dist-verify` 的校验目录，不入库）
admin-frontend/dist-verify/

# 小程序本地调试配置（含开发者自己的局域网 IP，不入库；模板见 config.local.example.js）
miniprogram/config.local.js

# 视觉回归截图（scripts/shoot.sh 产出，仅本机比对用，不入库）
.visual/

# 用户端构建校验目录（npx vite build --outDir dist-verify，不入库）
frontend/dist-verify/
frontend/dist-verify2/
frontend/dist-verify3/
