# ============================================================
# 后台管理端 - 生产环境配置模板
#
# 使用方法:
#   cp .env.example .env
#   只需填下面 5 项，其余留空即可启动（缺失项走后端默认值，或后续在后台界面配置）：
#     SECRET_KEY            随机密钥（openssl rand -hex 32）
#     MYSQL_ROOT_PASSWORD   数据库密码
#     REDIS_PASSWORD        缓存密码
#     NGINX_PORT            对外端口（默认 80）
#     SITE_BASE_URL         站点根地址（用于 sitemap / 分享链接）
#
# 说明：模板项数较多是**为了可配置**，不是必填清单。
#   绝大多数第三方能力（对象存储 / 邮件 / AI / 支付 / 短信）建议在后台
#   「系统设置」里配——加密落库、可随时改、不用重启容器。
#
# 注意: .env 含敏感信息, 切勿提交到 git（.gitignore 已忽略）
# ============================================================

# ---------- 网关 ----------
# Nginx 对外暴露端口 (默认 80; 若 80 被占用或想用其他端口可改, 如 8080)
NGINX_PORT=80

# ---------- 应用密钥 (必填, 强烈建议 32+ 字符随机串) ----------
# 生成命令: openssl rand -hex 32  或  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=请替换为32字符以上的随机密钥

# ---------- 数据库 (MySQL) ----------
MYSQL_DATABASE=ai_cat
# 必填: 使用强密码 (字母+数字+符号, 16 位以上)
MYSQL_ROOT_PASSWORD=请替换为强密码

# ---------- Redis ----------
# 必填: 使用强密码
REDIS_PASSWORD=请替换为强密码

# ---------- 种子数据的管理员口令 (可选) ----------
# 只被 backend/seed_data.py 读。真实行为是:
#   有值 -> 用它; 留空 -> `secrets.token_urlsafe(16)` 随机生成，并在创建那一次**只打印一行**
# 所以留空时务必当场抄下 `docker compose run --rm migrate python seed_data.py` 的输出，
# 错过就只能重建管理员账号 —— 仓库里各处文档写的 admin123456 从来不是默认口令。
# 留空即完全随机（更安全），需要固定口令（例如演示环境）才填这里。
ADMIN_PASSWORD=

# ---------- AI 服务 (可选, 只填实际用到的那家; 三家均为 OpenAI 兼容协议) ----------
# 工具的「AI 模型」字段填 provider 名: deepseek / openai / qwen。
# ⚠️ 未填 Key 的 provider 在调用时会返回「未配置」错误, 不会静默改用别家模型
#    (静默换模型会改变成本与输出质量, 必须让配置者看见)。
#
# 📌 也可以不改这里, 直接在「管理后台 → 系统设置 → AI 模型」配置
#    (2026-10-10 新增)：密钥加密存储、保存后即时生效、无需重启容器。
#    **两处都配置时以后台为准**；此处留空即完全由后台接管。
#    本文件仍保留这些项, 是为了支持「不开后台也能跑」以及首次部署的默认值。
DEEPSEEK_API_KEY=
# 以下三项有内置默认值, 需要换模型/走代理时才改动
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 通义千问: 阿里云百炼(DashScope) 的 OpenAI 兼容端点
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
AI_WRITING_ENABLED=false
AI_WRITING_IMAGE_DAILY_LIMIT=30

# 自定义 (OpenAI 兼容): Moonshot/智谱/SiliconFlow/Ollama/OneAPI 等。
# 通常不需要在这里配: Base URL 与上游模型名在「模型管理」里逐条填写。
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# 后台「系统设置 → AI」里 ai_*_base_url 的主机白名单(逗号分隔, 按点分后缀匹配)。
# ⚠️ 这些 URL 会被服务端直接发起请求, 且请求头带着对应 Provider 的 API Key ——
#    不设白名单时, 能改这一个配置项就等于能读走密钥(第四轮全量审查 P1-51)。
#    内网/环回/链路本地地址无论怎么配都被拒绝。
# 走自建 OpenAI 兼容代理时在这里追加域名, 例如:
#    AI_BASE_URL_ALLOWED_HOSTS=deepseek.com,openai.com,aliyuncs.com,api.my-proxy.com
AI_BASE_URL_ALLOWED_HOSTS=deepseek.com,openai.com,aliyuncs.com

# 默认 provider (工具未指定模型时使用), 取值须是上面三者之一
DEFAULT_AI_MODEL=deepseek

# ---------- 邮件 SMTP (注册验证码, 可选) ----------
# 留空 SMTP_HOST 则禁用邮件发送 (开发环境会在日志打印验证码)
# QQ 邮箱: password 填授权码(非登录密码), 获取方式见 QQ邮箱 设置->账户->SMTP服务
# 默认**全部留空 = 邮件发送关闭**（开发环境会在日志里打印验证码，见 SMTP_HOST 说明）。
# 不要在这里填真实邮箱：模板会进版本库，`deploy.sh` 又会直拷它，
# 内置别人的地址 = 让只换占位符的人用别人的邮箱发注册验证码（第四轮审查 P2-50④）。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_SENDER_NAME=AI学习猫

# ---------- GitHub README 拉取 (管理后台扩展编辑, 可选) ----------
# Personal Access Token: 提升匿名速率上限 (60次/小时 → 5000次/小时)
GITHUB_TOKEN=
# GitHub 出站代理 (可选, 如 http://172.17.0.1:7890): 仅对 GitHub 域名请求
# 生效 (官方 API 与图片转存的兜底源), COS/内网服务/用户访问均不走代理。
# 适用于 SSH 反向隧道借用本地代理: 服务器 sshd_config 开启
# GatewayPorts clientspecified 并重启 sshd 后, 本地执行
#   ssh -N -R 172.17.0.1:7890:127.0.0.1:7890 user@服务器IP
# 再填 http://172.17.0.1:7890 (docker0 网桥地址, 容器可达且不暴露公网)
GITHUB_PROXY=
# GitHub 加速镜像前缀 (需以 / 结尾): 服务器无法直连 GitHub 时配置。
# 拉取顺序为 jsDelivr CDN → 官方 API → 官方 API(经 GITHUB_PROXY) → 此镜像,
# 一般无需配置; 若 jsDelivr 也不可达, 可填 ghproxy 类镜像, 如 https://mirror.ghproxy.com/
GITHUB_MIRROR_PREFIX=

# ---------- 模块开关 ----------
# 逗号分隔的模块 key，留空 = 按默认（支付 / 积分 / 实名审核默认关闭）。
# 填了就**只启用列出的模块**（核心模块始终启用）。可选值见 backend/app/module_registry.py。
# 例：只留内容与审核 -> ENABLED_MODULES=core,tutorial,resource,node,moderation,ops
ENABLED_MODULES=

# ---------- 文件存储驱动 ----------
# local = 写本机磁盘（默认，不需要任何云账号；文件落在 uploads 卷里，由 /uploads 提供）
# cos   = 腾讯云对象存储（生产/CDN 场景，需要下面的 COS_* 凭据）
# 选 cos 后，下面的「腾讯云 COS」段才需要填；选 local 时整段留空即可。
STORAGE_DRIVER=local
# local 驱动的存放目录。容器内固定为 /app/uploads（对应 compose 的 uploads_data 卷），
# 本地直接跑后端时默认 ./uploads，一般不用改。
# STORAGE_LOCAL_DIR=./uploads
# local 驱动的对外访问前缀，留空则用 SITE_BASE_URL 拼成 {base}/uploads/{key}
# STORAGE_PUBLIC_BASE=

# ---------- 腾讯云 COS (对象存储, 必填否则上传不可用) ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=cat-1309118228
COS_REGION=ap-guangzhou
# 可选: CDN/自定义域名, 留空则使用默认 COS 域名
COS_CDN_DOMAIN=

# ---------- SEO (可选) ----------
# 对外站点根地址（sitemap 生成与百度推送 URL 拼接用）
SITE_BASE_URL=http://localhost
# 百度搜索资源平台「普通收录-API推送」token:
# 获取路径: ziyuan.baidu.com → 搜索服务 → 普通收录 → API提交
# 留空则每日自动推送任务跳过（不影响 sitemap 等其它功能）
BAIDU_PUSH_TOKEN=
# Bing IndexNow 即时收录密钥（Bing/Yandex/Naver/Seznam 共用协议）:
# 生成方式: openssl rand -hex 16（32 位十六进制字符串）
# 密钥文件由后端 /api/v1/indexnow-key 路由动态输出（nginx 自动转发 /{key}.txt），
# 留空则推送任务与密钥文件同时停用
INDEXNOW_KEY=

# ---------- 第三方资料导入 (可选) ----------
# 后台「从第三方导入正文」拉取 HuggingFace 模型卡用的 Access Token:
# 匿名拉取公开资源已够用, 配置后可拉取受限(Gated)资源并提升速率限制
HF_TOKEN=
# 国外文章平台出站代理 (X/Twitter、Reddit、Medium、Hacker News 的正文与图片请求):
# 格式与 GITHUB_PROXY 相同。服务器可直连国外站点时留空。
# 国内平台、GitHub/HuggingFace 及外部用户访问均不受影响
ARTICLE_PROXY=

# ---------- 微信小程序 (小程序端登录必需) ----------
# 留空时: 开发环境用 mock openid 便于联调; **生产环境微信登录直接返回 503**
# 获取: 微信公众平台 → 开发 → 开发管理 → 开发设置
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
# 小程序内嵌 H5 / 图片素材的 CDN 域名 (选填, 用于小程序端拼接绝对地址)
MINI_ASSET_BASE_URL=

# ---------- 业务参数 (可选, 改完 restart 即可, 无需重建镜像) ----------
# 免费体验时长上限 (秒), 默认 10800 = 3 小时
FREE_TIME_LIMIT=10800
# 单用户 AI 日调用上限, 默认 50 次
AI_DAILY_LIMIT_PER_USER=50
# 全站 AI 成本护栏 (台账 P1-2): 当日/当月 AI 调用总数触顶后拒绝后续调用, 防批量账号刷量。
# ⚠️ 默认 0 = 不限制 (升级前后行为完全一致)。后台「数据看板」会统计真实用量,
#    建议先观察几天再设阈值, 推荐 日 5000 / 月 80000 (约为单用户日限额的 100 倍)。
#    设为 0 即关闭对应维度的限制。
AI_GLOBAL_DAILY_LIMIT=0
AI_GLOBAL_MONTHLY_LIMIT=0
# AI 用量看板的费用估算单价 (元 / 百万 tokens)。默认 0 = 只显示次数与 tokens, 不算金额。
# 需要金额时按官网当前价目表填写 (官方定价会调整, 故不预置默认值)。
# 下面是**兜底价**: 未在 AI_MODEL_PRICES 里单列的模型都按它计价。
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
# 按模型单列单价 (JSON)。多模型混用时**必须**配, 否则会用一个单价去估所有模型
# (DeepSeek 与 OpenAI 价差可达一个数量级, 金额会明显偏离)。
# 键是 provider 名: deepseek / openai / qwen; 未列出的模型回落上面的兜底价。
# 示例 (数字需按官网当前价目表替换):
#   AI_MODEL_PRICES={"deepseek":{"input":1.0,"output":2.0},"openai":{"input":10.0,"output":30.0}}
AI_MODEL_PRICES=
# 限流阈值 (固定窗口计数器): 被刷量时可用它临时收紧, 无需改代码
RATE_LIMIT_GUEST=120
RATE_LIMIT_USER=300
RATE_LIMIT_WINDOW=60

# ---------- UGC 内容审核 (备案站点必备, 台账 P0-5) ----------
# 总开关: false = 跳过全部敏感词检查（仅排障用, 生产保持 true）
MODERATION_ENABLED=true
# 命中处置: reject=拒绝提交(默认, 最稳) / mask=打码后入库 / review=入库待人工复核
MODERATION_ACTION=reject
# 追加敏感词: 逗号分隔, 在内置基线词库（广告引流/黑产/辱骂）之上追加。
# 运营调整词库改这里 + docker compose restart app 即可, 无需发版。
MODERATION_EXTRA_WORDS=

# ---------- 中文全文检索 (台账 P1-1) ----------
# 教程/资源检索改用 MySQL 8 内置 ngram 全文索引（零新增组件）。
# 总开关: false = 一键退回改造前的 LIKE 行为（全文出问题时排障用, 无需改代码发版）
SEARCH_FULLTEXT_ENABLED=true
# ngram 分词粒度，必须与 mysql 服务的 --ngram_token_size 一致（默认 2）
SEARCH_NGRAM_TOKEN_SIZE=2
# 超过该长度的关键词直接走 LIKE（查询串过长会被 MySQL 拒绝: errno 191）
SEARCH_MAX_KEYWORD_LEN=64

# ---------- 错误监控 (可选, 强烈建议配置) ----------
# 留空 = 完全不启用（不加载 SDK、零网络请求）。
# 填 DSN 即启用: 未捕获异常与 ERROR 日志会带堆栈上报, 否则线上 500
# 只能等用户投诉才知道。
# 支持 Sentry SaaS, 也支持自建 GlitchTip（协议兼容, 填其项目 DSN 即可）
SENTRY_DSN=
# 上报环境名, 默认 production
SENTRY_ENVIRONMENT=production
# 发布版本号: 建议填 git short sha, 用于区分「哪个版本开始出这个错」
# 例: APP_RELEASE=$(git rev-parse --short HEAD)
APP_RELEASE=
# 升级检查用的 GitHub 仓库（owner/repo）。留空 = 不检查最新 release，
# 后台「版本与升级」只显示当前版本与迁移状态（离线 / 自建镜像也能正常用）。
APP_UPDATE_REPO=
# 性能追踪采样率: 0 = 只上报错误(默认); 0.1 = 额外采样 10% 请求做链路追踪
SENTRY_TRACES_SAMPLE_RATE=0

# 前端错误监控 DSN（浏览器端，构建期注入）。可留空。
# 注意: 这是「构建期」变量, 改完必须重新构建镜像才生效:
#   docker compose build nginx && docker compose up -d nginx
# 想区分前后端可在 Sentry 建两个项目, 分别填 SENTRY_DSN 与本项;
# 前后台共用同一个 DSN 也可以（后台页面路径均以 /admin/ 开头, 可据此筛选）
VITE_SENTRY_DSN=

# ---------- CORS (可选) ----------
# 经 Nginx 同源反向代理后, 前后端同源, 通常无需配置 CORS
# 若需额外放行其他来源, 逗号分隔, 如: http://1.2.3.4:8080,https://example.com
CORS_ORIGINS=

# ---------- 限流可信代理 (可选) ----------
# 仅当请求直连对端命中此 CIDR/IP 列表时才信任 X-Forwarded-For / X-Real-IP 头。
# Docker Compose 部署中 nginx 位于容器私网, 默认值(回环+RFC1918 私网)已覆盖, 无需配置。
# 仅当存在多层公网代理等特殊拓扑时才需显式指定, 逗号分隔, 如: 172.18.0.0/16,10.0.0.5
TRUSTED_PROXIES=


# ---------- 看门狗告警 (可选, 但强烈建议配置 —— 不配则线上故障无人知晓) ----------
# ⚠️ 这些变量**不进容器**，由宿主机脚本 scripts/watchdog.sh 读取（cron 每 5 分钟跑一次），
#    所以只写在 .env 里即可，不需要（也不能）加到 docker-compose.yml。
#    （正因如此它们登记在 scripts/check_env_consistency.py 的 ALLOW_HOST_ONLY 里。）
#
# 检查项：深度探活非 200（覆盖 MySQL/Redis 连通、会话时区、schema 版本）·
#         容器 restarting 崩溃循环 · 磁盘使用率 · 备份是否新鲜（「装了 cron 但没在跑」）·
#         备份目录是否可写。
#
# 开通三步（详见 docs/04-运维/部署说明书.md「告警通道」）：
#   1) 在本文件所在目录的 .env 里填 WATCHDOG_WEBHOOK（企业微信机器人地址即可）
#   2) ./scripts/watchdog.sh --install-cron
#   3) ./scripts/watchdog.sh --doctor   （自检：配了吗 / 配在哪 / 装了吗）
#
# 告警 webhook 地址。企业微信机器人 / 飞书 / 钉钉 / 自建接收端均可（按企业微信 JSON 格式发送），
# Server酱（sctapi.ftqq.com）会自动改用 form 表单。留空 = 只写本地日志、不推送。
WATCHDOG_WEBHOOK=
# 深度探活地址。默认走 nginx 的 /api/v1/health/deep（这才是「app 真的在服务」的信号，
# 会因 MySQL/Redis 故障与 schema 漂移返回 503）。
WATCHDOG_HEALTH_URL=http://127.0.0.1/api/v1/health/deep
# 探针的 Host 头，默认与站点主域名一致。
# ⚠️ 必须保留：nginx 对 80 端口的默认 server 块是「裸域 301 收敛到 www」，
#    不带 Host 的探针会命中它拿到 301，被判成故障（这就是「看门狗开箱即报假警」的成因）。
#    换域名时同步改这里。
WATCHDOG_HEALTH_HOST=www.wdmao.cn
# 磁盘使用率告警阈值（%）。磁盘满会让 MySQL 写不进、备份也写不下。默认 85。
WATCHDOG_DISK_PERCENT=85
# 最近一份备份超过多少小时即告警（默认 48，覆盖「每日备份 + 一天容错」）。
WATCHDOG_BACKUP_MAX_AGE_HOURS=48
# 备份的**离机副本**（2026-10-27 新增，当前最高优先级的运维缺口）：
# 备份与本机同盘时，机器/磁盘故障会同时丢数据与备份。填一条上传命令即可，
# 脚本会在「本地备份已落盘并校验通过」之后执行它，并注入两个变量：
#   BACKUP_FILE = 刚生成的 .sql.gz 绝对路径
#   BACKUP_NAME = 文件名
# 例：
#   BACKUP_AFTER_HOOK='rclone copy "$BACKUP_FILE" remote:ai-cat-backup/'
#   BACKUP_AFTER_HOOK='scp -q "$BACKUP_FILE" backup@10.0.0.9:/data/ai-cat/'
# 留空 = 不做离机副本（本地备份照常生成）。
BACKUP_AFTER_HOOK=

# ---- 后台「系统状态」卡（只读运维视图）----
# 最近备份超过多少小时算「过旧」。默认 48，与上面的 WATCHDOG_BACKUP_MAX_AGE_HOURS
# 保持同一口径（两处不一致会出现「看门狗说正常、后台说备份过期」）。
BACKUP_STALE_HOURS=48
# 状态接口结果缓存秒数（聚合里含一次 MySQL 探测）。默认 30，调 0 = 每次刷新都实探。
SYSTEM_STATUS_CACHE_SECONDS=30
# cron 表达式，默认每 5 分钟。
# ⚠️ 必须加引号：deploy.sh 会 `source` 整个 .env，不加引号会被 shell 当命令执行
#    （`*/5 * * * *` 里的 `*` 会被当通配符），导致部署脚本直接报错退出。
WATCHDOG_CRON='*/5 * * * *'
# 单次检查的超时秒数，默认 10。
WATCHDOG_TIMEOUT=10
# 同一告警的抑制窗口（秒），默认 1800（30 分钟）。
# 持续故障每 5 分钟推一条会把机器人刷屏，反而盖住「故障刚开始」那一条；
# 窗口内同类告警只写 watchdog.log，不再推送。
WATCHDOG_ALERT_SUPPRESS_SECONDS=1800
# 看门狗日志轮转阈值（字节），默认 5242880（5MB）。超过即把当前日志改名为
# watchdog.log.1（只保留 1 份历史），避免容器反复崩溃时把磁盘写满。
WATCHDOG_LOG_MAX_BYTES=5242880

# ---- 后台「素材库 → 图片搜索」（2026-10-29 补：此前只写在 backend/.env.example，
#      生产填了也不生效 —— compose 没注入，check_env_consistency.py 会报红）----
# 总开关：关闭后后台图片搜索入口整体不可用（默认关，配齐 Key 再开）
IMAGE_SEARCH_ENABLED=false
# 各图源 Key（Pexels / Pixabay / Giphy 需要申请；留空 = 该源不可用但不会报错）
IMAGE_SEARCH_PEXELS_KEY=
IMAGE_SEARCH_PIXABAY_KEY=
IMAGE_SEARCH_GIPHY_KEY=
# MemeCub（表情包源）Key：免费额度有限，留空即跳过该源
IMAGE_SEARCH_MEMECUB_KEY=
# 逐源开关：Key 配齐后按需打开；关掉即不再请求该源
IMAGE_SEARCH_PEXELS_ENABLED=true
IMAGE_SEARCH_PIXABAY_ENABLED=true
IMAGE_SEARCH_GIPHY_ENABLED=true
IMAGE_SEARCH_TENOR_ENABLED=false
IMAGE_SEARCH_BAIDU_ENABLED=false
IMAGE_SEARCH_SOGOU_ENABLED=false
IMAGE_SEARCH_DOUTUPK_ENABLED=false
IMAGE_SEARCH_EMOJI_ENABLED=false
# 每页条数与后台限额（防把免费额度刷穿）
IMAGE_SEARCH_PAGE_SIZE=24
IMAGE_SEARCH_ADMIN_HOURLY_LIMIT=120
IMAGE_SEARCH_DAILY_IMPORT_LIMIT=200
