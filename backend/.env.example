# ============================================================
# 本地开发最小配置（在 backend/ 内直接跑，不走 Docker Compose）
#
# 单一事实来源是仓库根目录的 ../.env.example（生产模板，含全部可配置项）。
# 本文件只保留「本地直连 MySQL / Redis 必定要改」的键，默认值与根模板逐字一致，
# 不再各写一套——历史上这两份曾差出 19 个键，改了一边另一边就过时。
#
# 用法:
#   cp .env.example .env
#   只需改 SECRET_KEY / DB_PASSWORD / REDIS_PASSWORD 三项即可启动；
#   AI Key、对象存储、邮件、支付等可选键请参考 ../.env.example，
#   或直接在「管理后台 → 系统设置」里配置（加密落库、即时生效）。
#
# 注意: .env 含敏感信息, 切勿提交到 git（.gitignore 已忽略）
# ============================================================

# ---------- 应用 ----------
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=请替换为32字符以上的随机密钥

# ---------- JWT ----------
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ---------- 数据库（MySQL） ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_cat
DB_USER=root
DB_PASSWORD=root

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
