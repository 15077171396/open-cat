# ========== 应用配置 ==========
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=<请替换为随机32字符密钥>

# ========== JWT 配置 ==========
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ========== 数据库配置 (MySQL) ==========
# 注意：生产环境必须修改为强口令
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_cat
DB_USER=root
DB_PASSWORD=root

# ========== Redis 配置 ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== AI API 配置 ==========
# 多模型 (台账 P2-4): 内置三家 + 一个自定义, 均为 OpenAI 兼容协议, 只填实际用到的那家的 Key。
# 工具的 ai_config.model 填 provider 名: deepseek / openai / qwen / custom。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 通义千问: 阿里云百炼 (DashScope) 的 OpenAI 兼容端点
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

DASHSCOPE_IMAGE_API_KEY=
DASHSCOPE_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
DASHSCOPE_IMAGE_MODEL=wanx2.1-t2i-turbo
AI_WRITING_ENABLED=false
AI_WRITING_IMAGE_DAILY_LIMIT=30
# 编辑器图片搜索（后台「系统设置 → 上传与素材 → 图片搜索」也可配置，后台优先）
IMAGE_SEARCH_ENABLED=false
IMAGE_SEARCH_PEXELS_KEY=
IMAGE_SEARCH_PIXABAY_KEY=
IMAGE_SEARCH_GIPHY_KEY=
IMAGE_SEARCH_PEXELS_ENABLED=true
IMAGE_SEARCH_PIXABAY_ENABLED=true
IMAGE_SEARCH_GIPHY_ENABLED=true
IMAGE_SEARCH_TENOR_ENABLED=false
IMAGE_SEARCH_BING_ENABLED=false
IMAGE_SEARCH_BAIDU_ENABLED=false
IMAGE_SEARCH_SOGOU_ENABLED=false
IMAGE_SEARCH_DOUTUPK_ENABLED=false
IMAGE_SEARCH_EMOJI_ENABLED=false
IMAGE_SEARCH_PAGE_SIZE=24
IMAGE_SEARCH_ADMIN_HOURLY_LIMIT=120
IMAGE_SEARCH_DAILY_IMPORT_LIMIT=200

# 自定义 (OpenAI 兼容): Moonshot/智谱/SiliconFlow/Ollama/vLLM/OneAPI 等都能接。
# Base URL 与上游模型名通常在「模型管理」里按模型逐条填, 这里留空即可。
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# 后台 ai_*_base_url 的主机白名单(逗号分隔, 点分后缀匹配)。这些 URL 会被服务端
# 直接请求且带头带 API Key, 见根 .env.example 的同一项说明 (第四轮审查 P1-51)。
AI_BASE_URL_ALLOWED_HOSTS=deepseek.com,openai.com,aliyuncs.com

DEFAULT_AI_MODEL=deepseek
AI_DAILY_LIMIT_PER_USER=50
AI_TIMEOUT_SECONDS=30
AI_RETRY_COUNT=2
# 全站 AI 成本护栏 (台账 P1-2): 当日/当月调用总数触顶后拒绝后续调用。
# 默认 0 = 不限制 (保持升级前后行为一致); 建议观察用量后再设 日 5000 / 月 80000。
AI_GLOBAL_DAILY_LIMIT=0
AI_GLOBAL_MONTHLY_LIMIT=0
# 用量看板的费用估算单价 (元 / 百万 tokens); 默认 0 = 只统计 tokens 不算金额
# AI_PRICE_* 是**兜底价**; 多模型混用时用 AI_MODEL_PRICES 按模型单列, 否则会算错
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
# 按模型单列单价 (JSON): {"deepseek":{"input":1.0,"output":2.0}, ...}
AI_MODEL_PRICES=

# ========== 邮件 SMTP 配置 (注册验证码) ==========
# 留空 SMTP_HOST 则禁用邮件发送 (开发环境会在日志打印验证码)
# QQ 邮箱示例: host=smtp.qq.com port=587 password=授权码(非登录密码)
# 默认**全部留空 = 邮件发送关闭**（开发环境会在日志里打印验证码，见 SMTP_HOST 说明）。
# 不要在这里填真实邮箱：模板会进版本库，`deploy.sh` 又会直拷它，
# 内置别人的地址 = 让只换占位符的人用别人的邮箱发注册验证码（第四轮审查 P2-50④）。
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_SENDER_NAME=AI学习猫

# ========== CORS ==========
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ========== 第三方资料拉取（管理后台「从第三方导入正文」） ==========
# 以下均为可选：服务器可直连对应站点时留空即可。
# 出站代理格式：http://host:port（如 http://127.0.0.1:7890）。
# Docker 部署时容器访问宿主机代理用 docker0 网桥地址 http://172.17.0.1:7890。
# 仅影响后台管理员发起的拉取，前台用户访问与国内平台均不受影响。

# 可选 GitHub 出站代理（服务器无法直连 GitHub 时使用）
GITHUB_PROXY=
# 可选 GitHub 加速镜像前缀（需以 / 结尾，如 https://mirror.ghproxy.com/）
GITHUB_MIRROR_PREFIX=
# 可选 HuggingFace Access Token（匿名拉取公开资源已够用；配置后可拉取受限资源）
HF_TOKEN=
# 可选国外文章平台出站代理（X/Twitter、Reddit、Medium、Hacker News 正文与图片请求）
ARTICLE_PROXY=

# ========== 对象存储 (腾讯云 COS) ==========
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=cat-1309118228
COS_REGION=ap-guangzhou
# 可选自定义访问域名 (CDN/自定义域名), 留空则使用默认 COS 域名
COS_CDN_DOMAIN=
# 资源文件大小上限 (20MB), 超出则拒绝并提示使用网盘
COS_MAX_FILE_SIZE=20971520
# 编辑器图片大小上限 (5MB)
COS_IMAGE_MAX_SIZE=5242880

# ========== 错误监控 (Sentry / GlitchTip) ==========
# 留空 = 完全不启用（不加载 SDK、零网络请求、零开销）。
# 填 DSN 即启用：线上未捕获异常、ERROR 日志会带堆栈上报。
# 自建 GlitchTip 填其项目 DSN 即可（协议兼容），无需改动代码。
SENTRY_DSN=
# 上报环境名，留空取 APP_ENV
SENTRY_ENVIRONMENT=
# 发布版本号，建议填 git short sha，用于区分「哪个版本开始出这个错」
APP_RELEASE=
# 升级检查用的 GitHub 仓库（owner/repo）。留空 = 不检查最新 release（离线也能用）
APP_UPDATE_REPO=
# 性能追踪采样率：0 = 只上报错误；0.1 = 额外采样 10% 请求做链路追踪
SENTRY_TRACES_SAMPLE_RATE=0

# 深度健康检查 (/api/v1/health/deep) 结果缓存秒数，用于吸收探活高频请求
HEALTH_DEEP_CACHE_SECONDS=5

# ========== 微信小程序（小程序端登录必需）==========
# 留空时：开发环境用 mock openid 便于联调；**生产环境微信登录直接返回 503**
# 获取：微信公众平台 → 开发 → 开发管理 → 开发设置
WECHAT_MINI_APPID=
WECHAT_MINI_SECRET=
# 小程序内嵌 H5 / 图片素材的 CDN 域名（选填，用于小程序端拼接绝对地址）
MINI_ASSET_BASE_URL=

# ========== 业务参数 ==========
# 免费体验时长上限（秒），默认 10800 = 3 小时
FREE_TIME_LIMIT=10800
# 单用户 AI 日调用上限，默认 50 次
AI_DAILY_LIMIT_PER_USER=50
# 全站 AI 成本护栏 (台账 P1-2)：0 = 不限制（默认，保持升级前后行为一致）
AI_GLOBAL_DAILY_LIMIT=0
AI_GLOBAL_MONTHLY_LIMIT=0
# 用量看板费用估算单价（元 / 百万 tokens），0 = 只统计 tokens
AI_PRICE_INPUT_PER_MTOK=0
AI_PRICE_OUTPUT_PER_MTOK=0
# 按模型单列单价（JSON），多模型混用时必需
AI_MODEL_PRICES=
# 限流阈值（固定窗口计数器）
RATE_LIMIT_GUEST=120
RATE_LIMIT_USER=300
RATE_LIMIT_WINDOW=60

# ========== 中文全文检索 (台账 P1-1) ==========
# 用 MySQL 8 内置 ngram 全文索引替代纯 LIKE，中文按 2 字切分。
# 总开关: false = 一键退回改造前的 LIKE 行为（全文出问题时排障用，无需改代码发版）
SEARCH_FULLTEXT_ENABLED=true
# ngram 分词粒度，必须与 MySQL 服务端启动参数 --ngram_token_size 一致（默认 2）。
# 不一致的表现：小于该长度的词全文查不到（会自动退回 LIKE，不会报错）
SEARCH_NGRAM_TOKEN_SIZE=2
# 超过该长度的关键词直接走 LIKE：查询串过长会被 MySQL 拒绝（errno 191）
SEARCH_MAX_KEYWORD_LEN=64

# 注：`SITE_BASE_URL` / `BAIDU_PUSH_TOKEN` / `INDEXNOW_KEY`（SEO 推送）、
# `GITHUB_TOKEN`（提升 GitHub 速率上限）、`TRUSTED_PROXIES`（多层代理拓扑）
# 仅在服务器部署时有意义，配置说明见仓库根目录 `.env.example`。
